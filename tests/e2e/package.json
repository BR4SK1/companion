{
  "name": "@companion/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end suite for the Companion web/BFF/worker slice. Runs only against a disposable, run-owned local test stack with a throwaway PostgreSQL and a local fake provider; never against a real application database or a live model provider.",
  "type": "module",
  "scripts": {
    "test": "node ./check-node-version.mjs && playwright test",
    "test:stack": "node ./check-node-version.mjs && node --test stack-ops.test.mjs",
    "test:smoke": "node ./check-node-version.mjs && node --test deployed-smoke.test.mjs",
    "test:deployed-smoke": "node ./check-node-version.mjs && node ./deployed-dev-smoke.mjs",
    "install:chromium": "node ./check-node-version.mjs && playwright install chromium",
    "show-report": "node ./check-node-version.mjs && playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  },
  "engines": {
    "node": "22.23.4"
  }
}
