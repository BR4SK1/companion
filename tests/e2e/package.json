{
  "name": "@companion/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Deployed Playwright end-to-end suite against the live companion-np Kubernetes deployment via kubectl port-forward.",
  "type": "module",
  "scripts": {
    "test": "node ./check-node-version.mjs && node ./run-e2e.mjs",
    "install:chromium": "node ./check-node-version.mjs && playwright install chromium",
    "show-report": "node ./check-node-version.mjs && playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  },
  "engines": {
    "node": "22.23.4"
  }
}
