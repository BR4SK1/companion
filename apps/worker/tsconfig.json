{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    // See libraries/postgres/tsconfig.json: skip .d.ts duplicate-declaration
    // noise from the hoisted second @types/node copy.
    "skipLibCheck": true,
    "paths": {
      "@companion/postgres": ["../../libraries/postgres/src/index.ts"],
      "@companion/openrouter": ["../../libraries/openrouter/src/decisions.ts"],
      "@companion/openrouter/*": ["../../libraries/openrouter/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
