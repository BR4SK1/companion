{
  "name": "@companion/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "First worker slice: durable grouped conversation work on PostgreSQL, with OpenRouter response-pattern decisions preceding chat generation.",
  "scripts": {
