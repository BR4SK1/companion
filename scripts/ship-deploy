#!/usr/bin/env bash
# Companion non-production ship deploy (repo-owned entry point).
#
# Called by the fleet wrapper as `./scripts/ship-deploy <SHA>` from the
# repository root. Builds web and worker images from `git archive <SHA>`,
# pushes them to the repositories configured in
# `.private/deploy/non-production-values.yaml`, deploys the digest-pinned
# candidate chart to namespace `companion-np` (release `companion`), verifies
# Ready pods run the pushed digests, and prints `SHIP_DEPLOYED_SHA=<SHA>`.
set -euo pipefail

NAMESPACE="companion-np"
RELEASE="companion"
VALUES_FILE=".private/deploy/non-production-values.yaml"

log() { printf 'ship-deploy: %s\n' "$*" >&2; }
fail() { log "ERROR: $*"; exit 1; }

[[ $# -eq 1 ]] || fail "usage: ./scripts/ship-deploy <40-hex-sha>"
CANDIDATE="$1"
[[ "$CANDIDATE" =~ ^[0-9a-f]{40}$ ]] || fail "invalid candidate SHA: $CANDIDATE"

for tool in git tar docker helm kubectl python3; do
  command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "must run inside a Git repository"
cd -- "$REPO_ROOT"

[[ "$(git rev-parse HEAD)" == "$CANDIDATE" ]] || fail "HEAD does not match candidate SHA ($CANDIDATE)"
[[ -z "$(git status --porcelain)" ]] || fail "working tree must be clean"
git cat-file -e "${CANDIDATE}^{commit}" 2>/dev/null || fail "commit not found: $CANDIDATE"
[[ -f "$VALUES_FILE" ]] || fail "missing values file: $VALUES_FILE"

# Read image repositories from the local-only non-production values file.
read -r WEB_REPO WORKER_REPO < <(
  python3 - "$VALUES_FILE" <<'PY'
import sys, yaml
data = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
web_repo = ((data.get("web") or {}).get("image") or {}).get("repository") or ""
worker_repo = ((data.get("worker") or {}).get("image") or {}).get("repository") or ""
if not web_repo or not worker_repo:
    sys.exit("web.image.repository and worker.image.repository are required")
print(web_repo, worker_repo)
PY
) || fail "failed to read image repositories from $VALUES_FILE"

TMP_ROOT="$(mktemp -d)"
trap 'rm -rf -- "$TMP_ROOT"' EXIT

# Extract immutable candidate source (never build from the working tree).
SOURCE_DIR="$TMP_ROOT/source"
mkdir -p -- "$SOURCE_DIR"
git archive "$CANDIDATE" | tar -x -C "$SOURCE_DIR"

build_and_push() {
  local label="$1" repo="$2" dockerfile="$3"
  local ref="${repo}:${CANDIDATE}"
  log "building $label image ($ref)"
  docker build \
    --label "org.opencontainers.image.revision=${CANDIDATE}" \
    --label "org.opencontainers.image.source=companion" \
    -f "${SOURCE_DIR}/${dockerfile}" \
    -t "$ref" \
    "$SOURCE_DIR" >&2

  log "pushing $label image ($ref)"
  docker push "$ref" >&2

  local digest
  digest="$(
    docker inspect "$ref" --format '{{json .RepoDigests}}' | python3 -c '
import json, re, sys
repo = sys.argv[1]
digests = json.load(sys.stdin) or []
prefix = f"{repo}@"
for entry in digests:
    if isinstance(entry, str) and entry.startswith(prefix):
        d = entry[len(prefix):]
        if re.fullmatch(r"sha256:[0-9a-f]{64}", d):
            print(d)
            sys.exit(0)
sys.exit(1)
' "$repo"
  )" || fail "could not determine pushed digest for $ref"
  printf '%s' "$digest"
}

WEB_DIGEST="$(build_and_push web "$WEB_REPO" "deploy/docker/Dockerfile.web")"
WORKER_DIGEST="$(build_and_push worker "$WORKER_REPO" "deploy/docker/Dockerfile.worker")"
log "pushed web ($WEB_DIGEST) and worker ($WORKER_DIGEST)"

log "upgrading Helm release $RELEASE in $NAMESPACE"
helm upgrade --install "$RELEASE" "${SOURCE_DIR}/deploy/helm/companion" \
  --namespace "$NAMESPACE" \
  -f "$VALUES_FILE" \
  --set "web.image.tag=${CANDIDATE}" \
  --set "web.image.digest=${WEB_DIGEST}" \
  --set "worker.image.tag=${CANDIDATE}" \
  --set "worker.image.digest=${WORKER_DIGEST}" \
  --wait \
  --timeout 5m >&2

# Verify Ready pods are running the exact pushed digests.
kubectl get pods -n "$NAMESPACE" -l "app.kubernetes.io/instance=${RELEASE}" -o json \
  | python3 -c '
import json, sys

web_digest, worker_digest = sys.argv[1], sys.argv[2]
pods = (json.load(sys.stdin) or {}).get("items") or []

def check(component, expected_digest):
    active = [
        p for p in pods
        if (p.get("metadata") or {}).get("labels", {}).get("app.kubernetes.io/name") == component
        and not (p.get("metadata") or {}).get("deletionTimestamp")
    ]
    if not active:
        sys.exit(f"no active {component} pod found")
    for pod in active:
        statuses = (pod.get("status") or {}).get("containerStatuses") or []
        match = [
            s for s in statuses
            if s.get("ready") is True and str(s.get("imageID") or "").endswith(f"@{expected_digest}")
        ]
        if match:
            return
    sys.exit(f"no Ready {component} pod running {expected_digest}")

check("web", web_digest)
check("worker", worker_digest)
' "$WEB_DIGEST" "$WORKER_DIGEST"

printf 'SHIP_DEPLOYED_SHA=%s\n' "$CANDIDATE"
